{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lynkly-qzop.onrender.com/api/:path*"
    },
    {
      "source": "/((?!login|signup|portal|assets|api)[^/.]+)",
      "destination": "https://lynkly-qzop.onrender.com/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
